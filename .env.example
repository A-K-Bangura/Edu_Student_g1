# Copy this file to .env and fill in values for your environment.
# Every VITE_* variable is exposed in the client bundle — never put secrets here.

# Production/staging API base URL (absolute https:// URL, or a same-origin
# path like /api/v1 when proxying through vercel.json). See src/config/env.ts
# for the mixed-content fallback this feeds into.
VITE_API_URL=

# Local development API base URL, used when VITE_API_URL is unset.
VITE_BASE_DEV_URL=http://127.0.0.1:8000/api/v1

# Environment label, informational only (defaults to "development").
VITE_ENV=development

# UniVybe support WhatsApp number, used by the onboarding "Can't find your
# university / faculty / department?" help. International format, country code
# first, digits only (a leading + and spaces are tolerated), e.g. 232XXXXXXXX.
# It is public by nature (it ends up in a wa.me link). When unset or invalid,
# onboarding shows a "support is unavailable" message instead of a link.
VITE_SUPPORT_WHATSAPP_NUMBER=

# Set to "true" to force-enable debug logging outside of dev mode.
# Debug logs are already on by default in dev (import.meta.env.DEV).
VITE_ENABLE_DEBUG_LOGS=false
